REBOL [
    Title: "Ornerede Browser"
    Version: 0.0.1
    Author: "Liam Prosser"
    Purpose: "A lightweight browser powered by QuillRE"
]

; Ornerede Browser v0.0.1

browser-name: "Ornerede Browser"
browser-version: "0.0.1"
browser-engine: "QuillRE"

print "================================"
print "       ORNEREDE BROWSER"
print "================================"

print rejoin ["Version: " browser-version]
print rejoin ["Engine: " browser-engine]

print ""
print "Welcome to Ornerede!"

; Browser startup
print "Loading browser settings..."
print "Loading bookmarks..."
print "Starting QuillRE..."

print ""
print "Ornerede startup complete."
